# Copy to .env.local and fill in. Never commit real values.
# Serve sample listings instead of live stores (local dev / E2E). Never enable in production.
ONECART_DEMO_PROVIDERS=false

# Every key is optional in development: missing provider keys disable that provider,
# missing Redis disables caching (searches still work, just cost more).

# AliExpress Affiliate API (Open Platform app); tracking id is AFFILIATE_ALIEXPRESS_TRACKING_ID below
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# eBay Browse API — Production keyset from developer.ebay.com (App ID = client id, Cert ID = secret).
# EBAY_CLIENT_ID / EBAY_CLIENT_SECRET work too. Dev ID isn't needed. EPN campaign id: AFFILIATE_EBAY_CAMPAIGN_ID below.
EBAY_APP_ID=
EBAY_CERT_ID=

# SerpApi (Amazon search engine)
SERPAPI_API_KEY=
# live = SerpApi (spends the 250/month quota); recorded = saved responses, no network.
# Unset: live only on Vercel production (VERCEL_ENV=production), recorded everywhere else.
SERPAPI_MODE=
# Pages per uncached Amazon query (1-3). Each page = 1 SerpApi credit, ~8-12 usable products when shipping to Israel.
SERPAPI_AMAZON_PAGES=2
SEARCHAPI_API_KEY=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SEARCH_CACHE_TTL_SECONDS=86400

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

DEEPL_API_KEY=

# Protects /api/cron/price-alerts (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Signs /go/ outbound links. Required in production; generate with: openssl rand -base64 48
OUTBOUND_LINK_SECRET=

AFFILIATE_AMAZON_TAG=
AFFILIATE_ALIEXPRESS_TRACKING_ID=
AFFILIATE_TEMU_CODE=
AFFILIATE_EBAY_CAMPAIGN_ID=

# Abuse protection (defaults in src/config/rate-limits.ts)
# Searches per IP:
SEARCH_RATE_LIMIT_PER_MINUTE=
SEARCH_RATE_LIMIT_PER_DAY=
# Live store API calls per day across all shoppers (eBay hard limit: 5,000/day):
EBAY_DAILY_CALL_BUDGET=
AMAZON_DAILY_CALL_BUDGET=
